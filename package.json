{
  "name": "xingyu-nav",
  "version": "1.0.0",
  "private": true,
  "description": "星屿导航 —— 私有 Cloudflare Pages + D1 导航主页",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler pages dev dist --port 8788 --persist-to .wrangler/state",
    "build": "vite build",
    "build:functions": "wrangler pages functions build --outdir .tmp/functions-build",
    "types": "wrangler types .tmp/worker-configuration.d.ts --include-runtime=false",
    "preview": "npm run build && wrangler pages dev dist --persist-to .wrangler/state",
    "typecheck": "npm run typecheck:app && npm run typecheck:server && npm run typecheck:node",
    "typecheck:app": "vue-tsc --noEmit -p tsconfig.json",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm run test:unit && npm run test:api",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:api": "vitest run --config vitest.workers.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "db:create": "wrangler d1 create xingyu-nav",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --persist-to .wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run build && wrangler pages deploy dist",
    "check:browser": "node scripts/browser-check.mjs"
  },
  "dependencies": {
    "vue": "^3.5.42",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260916.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.5",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.132.0"
  },
  "allowScripts": {
    "workerd@1.20260815.1": true,
    "workerd@1.20260915.1": true,
    "esbuild@0.28.1": true
  }
}
